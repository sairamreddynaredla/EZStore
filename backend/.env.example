# Copy this file to .env and replace the placeholder values.

# Postgres connection components
PG_USER=ezstore
PG_PASSWORD=password
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=ezstore

# DATABASE_URL
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgres://${PG_USER}:${PG_PASSWORD}@${PG_HOST}:${PG_PORT}/${PG_DATABASE}?schema=public

# JWT secrets used by the backend
JWT_SECRET=replace_with_a_strong_secret
JWT_REFRESH_SECRET=replace_with_a_strong_refresh_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_REFRESH_EXPIRES_MS=2592000000

# Frontend URL (used for CORS/allowed origins)
FRONTEND_URL=http://localhost:3000

# Backend port and runtime values
PORT=5000
NODE_ENV=development
BACKEND_URL=http://localhost:5000
ALLOWED_ORIGINS=http://localhost:5173
# Google OAuth (set these in production/dev with real values)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
