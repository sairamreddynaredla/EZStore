generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id                    Int                    @id @default(autoincrement())
  email                 String                 @unique
  password              String
  name                  String?
  role                  String                 @default("admin")
  status                String                 @default("active")
  lastLoginAt           DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?
  resetPasswordToken    String?
  resetPasswordExpiresAt DateTime?
  createdById           Int?
  updatedById           Int?
  createdBy             Admin?                 @relation("AdminCreatedBy", fields: [createdById], references: [id])
  createdAdmins         Admin[]                @relation("AdminCreatedBy")
  updatedBy             Admin?                 @relation("AdminUpdatedBy", fields: [updatedById], references: [id])
  updatedAdmins         Admin[]                @relation("AdminUpdatedBy")
  auditLogs             AuditLog[]
  inventoryTransactions InventoryTransaction[]
  notifications         Notification[]
}

model Customer {
  id                           Int                  @id @default(autoincrement())
  email                        String               @unique
  password                     String
  firstName                    String?
  lastName                     String?
  fullName                     String?
  phone                        String?
  profileImage                 String?
  dateOfBirth                  DateTime?
  gender                       String?
  status                       String               @default("active")
  emailVerified                Boolean              @default(false)
  emailVerifiedAt              DateTime?
  emailVerificationToken       String?
  emailVerificationTokenSentAt DateTime?
  resetPasswordToken           String?
  resetPasswordTokenExpiresAt  DateTime?
  refreshTokenHash             String?
  refreshTokenExpiresAt        DateTime?
  lastLoginAt                  DateTime?
  deletedAt                    DateTime?
  createdAt                    DateTime             @default(now())
  updatedAt                    DateTime             @updatedAt
  provider                     String               @default("local")
  googleId                     String?              @unique
  avatar                       String?
  providerId                   String?
  addresses                    Address[]
  cartItems                    CartItem[]
  notifications                Notification[]
  orders                       Order[]
  recentlyViewedItems          RecentlyViewedItem[]
  reviews                      Review[]
  savedItems                   SavedItem[]
  wishlistItems                WishlistItem[]
  payments                     Payment[]
}

model Address {
  id            Int      @id @default(autoincrement())
  customerId    Int
  label         String   @default("Home")
  recipientName String
  phone         String
  street        String
  city          String
  state         String
  postalCode    String
  country       String   @default("India")
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  customer      Customer @relation(fields: [customerId], references: [id])
  orders        Order[]
}

model Product {
  id                    Int                    @id @default(autoincrement())
  sku                   String?                @unique
  slug                  String                 @unique
  name                  String
  description           String?
  price                 Float
  originalPrice         Float?
  stock                 Int                    @default(0)
  status                String                 @default("active")
  categoryId            Int?
  brandId               Int?
  imageUrl              String?
  images                Json?
  tags                  Json?
  metadata              Json?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?
  isActive              Boolean                @default(true)
  lowStockThreshold     Int                    @default(5)
  trackInventory        Boolean                @default(true)
  cartItems             CartItem[]
  inventoryTransactions InventoryTransaction[]
  orderItems            OrderItem[]
  brand                 Brand?                 @relation(fields: [brandId], references: [id])
  category              Category?              @relation(fields: [categoryId], references: [id])
  recentlyViewedItems   RecentlyViewedItem[]
  reviews               Review[]
  savedItems            SavedItem[]
  wishlistItems         WishlistItem[]
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  description String?
  status      String    @default("active")
  banner      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  products    Product[]
}

model Brand {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  description String?
  status      String    @default("active")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  products    Product[]
}

model Order {
  id                Int                  @id @default(autoincrement())
  customerId        Int
  orderNumber       String               @unique
  status            String               @default("pending")
  totalAmount       Float
  items             Json
  placedAt          DateTime             @default(now())
  couponId          Int?
  currency          String?              @default("USD")
  orderDate         DateTime?            @default(now())
  paymentMethod     String?
  paymentStatus     String?
  shippingAddressId Int?
  metadata          Json?
  refundCompletedAt DateTime?
  refundReason      String?
  refundRequestedAt DateTime?
  shippingProvider  String?
  trackingNumber    String?
  coupon            Coupon?              @relation(fields: [couponId], references: [id])
  customer          Customer             @relation(fields: [customerId], references: [id])
  shippingAddress   Address?             @relation(fields: [shippingAddressId], references: [id])
  orderItems        OrderItem[]
  notes             OrderNote[]
  statusHistory     OrderStatusHistory[]
  payment           Payment?
}

model OrderItem {
  id          Int      @id @default(autoincrement())
  orderId     Int
  productId   Int?
  productName String
  productSku  String?
  quantity    Int      @default(1)
  unitPrice   Float
  totalPrice  Float
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  order       Order    @relation(fields: [orderId], references: [id])
  product     Product? @relation(fields: [productId], references: [id])
}

model Coupon {
  id                   Int                @id @default(autoincrement())
  code                 String             @unique
  description          String?
  discountType         CouponDiscountType @default(percent)
  discount             Float
  status               String             @default("active")
  expiresAt            DateTime?
  usageLimit           Int?
  usageCount           Int                @default(0)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  deletedAt            DateTime?
  applicableCategories Json?
  applicableProducts   Json?
  excludedCategories   Json?
  excludedProducts     Json?
  firstOrderOnly       Boolean?           @default(false)
  freeShipping         Boolean?           @default(false)
  maxDiscount          Float?
  minOrderAmount       Float?             @default(0)
  perUserLimit         Int?
  startsAt             DateTime?
  orders               Order[]
}

model CouponUsage {
  id         Int      @id @default(autoincrement())
  couponId   Int
  customerId Int?
  orderId    Int?
  createdAt  DateTime @default(now())

  @@unique([couponId, customerId, orderId])
  @@unique([couponId, customerId, orderId], map: "CouponUsage_coupon_customer_order_unique")
  @@index([couponId])
  @@index([customerId])
}

model Review {
  id         Int          @id @default(autoincrement())
  customerId Int
  productId  Int
  rating     Int
  title      String?
  comment    String?
  status     ReviewStatus @default(pending)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  deletedAt  DateTime?
  customer   Customer     @relation(fields: [customerId], references: [id])
  product    Product      @relation(fields: [productId], references: [id])
}

model StoreSettings {
  id                               Int       @id @default(autoincrement())
  storeName                        String?
  storeDescription                 String?
  contactEmail                     String?
  contactPhone                     String?
  supportEmail                     String?
  storeAddress                     String?
  defaultCurrency                  String    @default("USD")
  currencySymbol                   String    @default("$")
  timeZone                         String    @default("UTC")
  language                         String    @default("en")
  taxEnabled                       Boolean   @default(false)
  taxPercentage                    Float     @default(0)
  freeShippingThreshold            Float     @default(0)
  flatShippingCharge               Float     @default(0)
  estimatedDeliveryDays            Int?      @default(0)
  paymentMethods                   Json?
  emailNotificationsEnabled        Boolean   @default(true)
  orderNotificationsEnabled        Boolean   @default(true)
  registrationNotificationsEnabled Boolean   @default(true)
  sessionTimeoutMinutes            Int       @default(30)
  twoFactorEnabled                 Boolean   @default(false)
  logoUrl                          String?
  faviconUrl                       String?
  removeLogo                       Boolean   @default(false)
  removeFavicon                    Boolean   @default(false)
  createdAt                        DateTime  @default(now())
  updatedAt                        DateTime  @updatedAt
  deletedAt                        DateTime?
}

model Notification {
  id         Int                 @id @default(autoincrement())
  customerId Int?
  adminId    Int?
  title      String
  message    String
  type       NotificationType    @default(system)
  channel    NotificationChannel @default(in_app)
  isRead     Boolean             @default(false)
  metadata   Json?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  admin      Admin?              @relation(fields: [adminId], references: [id])
  customer   Customer?           @relation(fields: [customerId], references: [id])
}

model AuditLog {
  id         Int         @id @default(autoincrement())
  adminId    Int?
  action     AuditAction @default(other)
  entity     String
  entityId   Int?
  entityName String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())
  admin      Admin?      @relation(fields: [adminId], references: [id])
}

model Payment {
  id               Int           @id @default(autoincrement())
  paymentNumber    String?       @unique
  orderId          Int           @unique
  customerId       Int?
  method           String
  status           String        @default("pending")
  provider         String?
  transactionId    String?
  providerOrderId  String?
  amount           Float
  currency         String        @default("USD")
  metadata         Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  paymentIntentId  String?
  stripeCustomerId String?
  order            Order         @relation(fields: [orderId], references: [id])
  customer         Customer?     @relation(fields: [customerId], references: [id])
  transactions     Transaction[]
  refunds          Refund[]
}

model Transaction {
  id                    Int      @id @default(autoincrement())
  transactionId         String   @unique
  paymentId             Int
  orderId               Int
  provider              String
  providerTransactionId String?
  type                  String   @default("charge")
  status                String   @default("pending")
  amount                Float
  currency              String   @default("USD")
  gatewayResponse       Json?
  errorCode             String?
  errorMessage          String?
  createdAt             DateTime @default(now())
  payment               Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model Refund {
  id               Int      @id @default(autoincrement())
  refundNumber     String   @unique
  paymentId        Int
  orderId          Int
  provider         String
  providerRefundId String?
  amount           Float
  currency         String   @default("USD")
  reason           String?
  status           String   @default("pending")
  metadata         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  payment          Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model WebhookLog {
  id           Int       @id @default(autoincrement())
  provider     String
  eventId      String    @unique
  eventType    String
  payload      Json?
  status       String    @default("processing")
  errorMessage String?
  receivedAt   DateTime  @default(now())
  processedAt  DateTime?
}

model InventoryTransaction {
  id        Int      @id @default(autoincrement())
  productId Int
  adminId   Int?
  change    Int
  type      String
  reason    String?
  createdAt DateTime @default(now())
  admin     Admin?   @relation(fields: [adminId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
}

model OrderStatusHistory {
  id            Int      @id @default(autoincrement())
  orderId       Int
  status        String
  paymentStatus String?
  actorType     String?
  actorId       Int?
  note          String?
  createdAt     DateTime @default(now())
  order         Order    @relation(fields: [orderId], references: [id])
}

model OrderNote {
  id         Int      @id @default(autoincrement())
  orderId    Int
  authorType String   @default("admin")
  authorId   Int?
  note       String
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  order      Order    @relation(fields: [orderId], references: [id])
}

model CartItem {
  id              Int      @id @default(autoincrement())
  customerId      Int
  productId       Int
  productName     String
  productImage    String?
  unitPrice       Float
  quantity        Int      @default(1)
  variantKey      String?
  selectedVariant Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  customer        Customer @relation(fields: [customerId], references: [id])
  product         Product  @relation(fields: [productId], references: [id])

  @@unique([customerId, productId, variantKey])
}

model WishlistItem {
  id           Int      @id @default(autoincrement())
  customerId   Int
  productId    Int
  productName  String
  productImage String?
  productPrice Float
  createdAt    DateTime @default(now())
  customer     Customer @relation(fields: [customerId], references: [id])
  product      Product  @relation(fields: [productId], references: [id])

  @@unique([customerId, productId])
}

model SavedItem {
  id           Int      @id @default(autoincrement())
  customerId   Int
  productId    Int
  productName  String
  productImage String?
  productPrice Float
  createdAt    DateTime @default(now())
  customer     Customer @relation(fields: [customerId], references: [id])
  product      Product  @relation(fields: [productId], references: [id])

  @@unique([customerId, productId])
}

model RecentlyViewedItem {
  id           Int      @id @default(autoincrement())
  customerId   Int
  productId    Int
  productName  String
  productImage String?
  productPrice Float
  createdAt    DateTime @default(now())
  customer     Customer @relation(fields: [customerId], references: [id])
  product      Product  @relation(fields: [productId], references: [id])

  @@unique([customerId, productId])
}

/// Tracks idempotency keys used by clients to prevent duplicate order/payment creation
model IdempotencyKey {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  request   Json?
  response  Json?
  status    String   @default("processing")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Stores processed Stripe webhook events to deduplicate and for auditing
model StripeWebhookEvent {
  id          Int       @id @default(autoincrement())
  eventId     String    @unique
  eventType   String
  payload     Json?
  status      String    @default("processing")
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
}

enum CouponDiscountType {
  percent
  fixed
}

enum ReviewStatus {
  pending
  approved
  rejected
}

enum NotificationType {
  order_update
  product_alert
  promotional
  system
}

enum NotificationChannel {
  email
  sms
  push
  in_app
}

enum AuditAction {
  create
  update
  delete
  login
  logout
  other
}
