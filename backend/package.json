{
  "name": "ezstore-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon --watch src --exec node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev --name add-admin-reset-fields",
    "start": "node src/server.js",
    "start:prod": "node src/server.js",
    "seed": "node prisma/seed.js",
    "db:seed": "npm run seed",
    "test": "node --test --test-concurrency=1 --test-force-exit ./tests/*.test.js"
  },
  "engines": {
    "node": ">=20.19.0 <23"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^4.16.2",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^6.8.0",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "nodemailer": "^6.9.4",
    "pg": "^8.22.0",
    "socket.io": "^4.8.3",
    "stripe": "^12.16.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prisma": "^4.16.2"
  }
}
